{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"Metric Snapshot","type":"object",
  "required":["snapshot_id","employee_id","experiment_id","platform","post_id","captured_at","metrics"],
  "properties":{
    "snapshot_id":{"type":"string","minLength":1},"employee_id":{"type":"string","minLength":1},"experiment_id":{"type":"string","minLength":1},
    "platform":{"enum":["tiktok","instagram","x","threads","youtube_shorts"]},"post_id":{"type":"string","minLength":1},"captured_at":{"type":"string"},
    "metrics":{"type":"object","additionalProperties":false,"properties":{"impressions":{"type":["number","null"],"minimum":0},"views":{"type":["number","null"],"minimum":0},"reach":{"type":["number","null"],"minimum":0},"likes":{"type":["number","null"],"minimum":0},"comments":{"type":["number","null"],"minimum":0},"shares":{"type":["number","null"],"minimum":0},"saves":{"type":["number","null"],"minimum":0},"clicks":{"type":["number","null"],"minimum":0},"watch_time_seconds":{"type":["number","null"],"minimum":0},"video_duration_seconds":{"type":["number","null"],"minimum":0},"followers_gained":{"type":["number","null"],"minimum":0}}},
    "source":{"type":"string"},"complete":{"type":"boolean"}
  },"additionalProperties":false
}
